# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Ignore Python virtual environment folder
venv/

# Ignore .env files containing sensitive data
.env

# Streamlit-specific (track config.toml for theming, ignore secrets)
.streamlit/secrets.toml

# Jupyter Notebook checkpoints and notebooks
.ipynb_checkpoints
*.ipynb

# IDE-specific files
.idea/

# System files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*.swo
*.pid

# SQLite cache (including WAL/SHM companion files — *.db alone doesn't
# match these, which let them get tracked and drift out of sync with the
# actual .fpl_cache.db across branch switches, corrupting the cache DB)
*.db
*.db-shm
*.db-wal

# Locally-logged pending FPL transfers (user-specific, pre-deadline)
.fpl_pending_transfers.json

# Locally-set Draft/Classic league & team IDs (user-specific; repo is public)
league_settings.json

# Scoring test script cache
.scoring_test_cache/

# Environment configuration (sensitive values go in .env, not config.py)
.env