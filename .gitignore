# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Ignore Python virtual environment folder
venv/

# Ignore .env files containing sensitive data. The .bak glob matters: this
# repo is public and .env carries an API key and a Discord webhook, so a
# timestamped backup left lying around is one `git add -A` from being
# published -- the same accident that once committed nine "file 2.py" copies.
.env
.env.bak*

# Streamlit-specific (track config.toml for theming, ignore secrets)
.streamlit/secrets.toml

# Jupyter Notebook checkpoints and notebooks
.ipynb_checkpoints
*.ipynb

# IDE-specific files
.idea/

# System files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*.swo
*.pid

# SQLite cache (including WAL/SHM companion files — *.db alone doesn't
# match these, which let them get tracked and drift out of sync with the
# actual .fpl_cache.db across branch switches, corrupting the cache DB)
*.db
*.db-shm
*.db-wal

# Locally-logged pending FPL transfers (user-specific, pre-deadline)
.fpl_pending_transfers.json

# FPL session credential for the authenticated my-team endpoint (the only
# source of a pre-deadline squad). A secret, and user-specific — never commit.
.fpl_auth.json

# Locally-set Draft/Classic league & team IDs (user-specific; repo is public)
league_settings.json

# Local, permanent archive of personal league data (past season League
# Wrapped exports and their extracted data — team/manager names, repo is
# public) — never committed, never auto-deleted.
# Note this is `archive/*`, not `archive/`: git cannot re-include a file whose
# parent *directory* is excluded, so the negation below would silently do
# nothing against `archive/`.
archive/*

# ...except the FFP projection archive, which IS committed. FFP rolls its
# publication window forward and the old gameweek is gone from their site
# permanently — GW3 was lost exactly that way. This is public projection data
# with nothing personal in it, one immutable file per gameweek, and committing
# it is what makes the history survive a laptop. It is also the seed of the
# projection accuracy harness, which cannot measure anything without it.
!archive/ffp/
!archive/ffp/*.json

# Same for the projection snapshots: what every source said before each
# deadline, and what actually happened. Committed because the accuracy harness
# cannot measure anything without history, and history that lives on one laptop
# is one reinstall from being lost.
!archive/projections/
!archive/projections/*.json

# Scoring test script cache
.scoring_test_cache/

# Environment configuration (sensitive values go in .env, not config.py)
.env
# Finder/sync duplicates ("file 2.py"). These are never intentional, and one
# sweep of `git add -A` once committed nine of them by accident.
*[[:space:]]2.py
*[[:space:]]2.db
*[[:space:]]2.db-wal
